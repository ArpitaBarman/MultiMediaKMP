<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.BarmanMultimedia" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/classic_primary</item>
        <item name="colorPrimaryDark">@color/classic_primary_dark</item>
        <item name="colorAccent">@color/classic_accent</item>
        <item name="colorControlNormal">@color/classic_text_secondary</item>
        <item name="colorControlActivated">@color/classic_accent</item>
        <item name="colorControlHighlight">@color/classic_highlight</item>
        <item name="colorButtonNormal">@color/classic_background</item>
        <item name="android:windowBackground">@color/classic_background</item>
        <item name="android:colorBackground">@color/classic_background</item>
        <item name="android:textColorPrimary">@color/classic_text</item>
        <item name="android:textColorSecondary">@color/classic_text_secondary</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:statusBarColor">@color/classic_primary_dark</item>
        <item name="android:navigationBarColor">@color/classic_primary_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
        <item name="buttonStyle">@style/Widget.Barman.Button</item>
        <item name="spinnerStyle">@style/Widget.Barman.Spinner</item>
        <item name="android:progressBarStyleHorizontal">@style/Widget.Barman.ProgressBar</item>
    </style>

    <style name="Widget.Barman.Button" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/classic_button</item>
        <item name="backgroundTint">@null</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">80dp</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:textColor">@color/classic_button_text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="textAllCaps">true</item>
    </style>

    <style name="Widget.Barman.Spinner" parent="Widget.AppCompat.Spinner">
        <item name="android:background">@drawable/classic_spinner</item>
        <item name="backgroundTint">@null</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">40dp</item>
        <item name="android:popupBackground">@drawable/classic_panel</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="Widget.Barman.ProgressBar" parent="Widget.AppCompat.ProgressBar.Horizontal">
        <item name="android:progressDrawable">@drawable/classic_progress</item>
        <item name="android:progressTint">@color/classic_accent</item>
        <item name="android:progressBackgroundTint">@color/classic_border</item>
    </style>

    <style name="TextAppearance.Barman.Title" parent="TextAppearance.AppCompat.Title">
        <item name="android:textColor">@color/classic_text</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">normal</item>
    </style>

    <style name="TextAppearance.Barman.Section" parent="TextAppearance.AppCompat.Subhead">
        <item name="android:textColor">@color/classic_text</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Barman.Body" parent="TextAppearance.AppCompat.Body1">
        <item name="android:textColor">@color/classic_text</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="TextAppearance.Barman.Display" parent="TextAppearance.AppCompat.Display2">
        <item name="android:textColor">@color/classic_text</item>
        <item name="android:textSize">48sp</item>
    </style>
</resources>
