<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="@color/classic_selected" />
            <stroke android:width="1dp" android:color="@color/classic_border" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <gradient android:angle="270" android:startColor="#888888" android:endColor="#505050" />
            </shape>
        </clip>
    </item>
</layer-list>
