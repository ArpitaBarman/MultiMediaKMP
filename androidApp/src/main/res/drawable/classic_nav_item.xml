<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true" android:drawable="@color/classic_selected" />
    <item android:state_focused="true" android:drawable="@color/classic_selected" />
    <item android:state_checked="true">
        <layer-list>
            <item android:drawable="@color/classic_selected" />
            <item android:width="4dp" android:gravity="start" android:drawable="@color/classic_accent" />
        </layer-list>
    </item>
    <item android:drawable="@color/classic_surface" />
</selector>
