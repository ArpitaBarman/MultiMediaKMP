<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/classic_background" />
            <stroke android:width="1dp" android:color="@color/classic_border" />
            <corners android:radius="2dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#A5A5A5" android:endColor="#C5C5C5" />
            <stroke android:width="1dp" android:color="@color/classic_accent" />
            <corners android:radius="2dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/classic_selected" />
            <stroke android:width="2dp" android:color="@color/classic_primary" />
            <corners android:radius="2dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#FAFAFA" android:endColor="#CBCBCB" />
            <stroke android:width="1dp" android:color="#888888" />
            <corners android:radius="2dp" />
        </shape>
    </item>
</selector>
