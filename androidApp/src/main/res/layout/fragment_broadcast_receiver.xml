<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/classic_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select a broadcast type"
            android:textAppearance="@style/TextAppearance.Barman.Section" />

        <Spinner
            android:id="@+id/broadcastSpinner"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="18dp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/proceedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Proceed" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:text="Custom: enter text in the next activity, then the third activity receives it through a custom BroadcastReceiver.\n\nBattery: the next activity listens for ACTION_BATTERY_CHANGED and displays the battery percentage."
            android:textAppearance="@style/TextAppearance.Barman.Body"
            android:textColor="@color/classic_text_secondary" />
    </LinearLayout>
</ScrollView>
