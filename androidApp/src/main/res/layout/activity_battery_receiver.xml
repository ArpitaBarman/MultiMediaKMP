<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/classic_primary_dark"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/classic_background"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Battery Broadcast Receiver"
            android:textAppearance="@style/TextAppearance.Barman.Title" />

        <TextView
            android:id="@+id/batteryPercentText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:text="--%"
            android:textAppearance="@style/TextAppearance.Barman.Display" />

        <ProgressBar
            android:id="@+id/batteryProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:layout_marginTop="20dp"
            android:max="100" />

        <TextView
            android:id="@+id/batteryStatusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Waiting for ACTION_BATTERY_CHANGED…"
            android:textAppearance="@style/TextAppearance.Barman.Body" />
    </LinearLayout>
</FrameLayout>
